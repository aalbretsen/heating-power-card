{
  "name": "heating-power-card",
  "version": "0.2.2",
  "description": "Compact Home Assistant Lovelace card for heating power monitoring",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "heating",
    "power"
  ],
  "homepage": "https://github.com/aalbretsen/heating-power-card#readme",
  "bugs": {
    "url": "https://github.com/aalbretsen/heating-power-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aalbretsen/heating-power-card.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/heating-power-card.js",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:prod": "NODE_ENV=production rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
