# EditorConfig: https://editorconfig.org
# Supported by IntelliJ IDEA, VSCode (with plugin), Vim, Emacs, and many others.
# This file is the single source of truth for whitespace formatting — editors
# apply these rules automatically on save, independently of Prettier.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ts]
indent_size = 2
max_line_length = 180

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
